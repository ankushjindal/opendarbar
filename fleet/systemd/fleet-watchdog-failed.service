[Unit]
Description=Alert the owner when the fleet-watchdog itself fails

[Service]
Type=oneshot
# Replace OWNER_CHAT_ID below with your Telegram user id before installing.
ExecStart=/bin/bash -c 'tok=$(grep -oP "^TELEGRAM_BOT_TOKEN=\\K.*" /home/owner/.claude/channels/telegram/.env); curl -sS -m 10 "https://api.telegram.org/bot$tok/sendMessage" -d chat_id=OWNER_CHAT_ID --data-urlencode text="🔴 fleet-watchdog service itself FAILED — the watcher of the watchers is down. journalctl --user -u fleet-watchdog -n 30" >/dev/null'
